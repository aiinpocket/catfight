# 必填
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-too

# Caddy 監聽位址。填網域（例如 quiz.example.com）會自動申請 HTTPS 憑證；只在內網或有前置代理時用 :80
SITE_ADDRESS=:80

# 預設 Caddy 只綁 127.0.0.1（前面放 Cloudflare Tunnel 或其他反向代理）。
# 要直接對外服務，改成 80 / 443，並把 SITE_ADDRESS 換成網域。
#CADDY_HTTP_BIND=80
#CADDY_HTTPS_BIND=443
